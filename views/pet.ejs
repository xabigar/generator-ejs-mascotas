<%- include('partials/header') %>

<h2>Mascotas de <%= owner.name %></h2>
<p>Email: <a href="mailto:<%= owner.email %>"><%= owner.email %></a></p>

<% if (ownerPets.length === 0) { %>
    <p>Este dueño no tiene mascotas registradas.</p>
<% } else { %>
    <table>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Especie</th>
            <th>Acciones</th>
        </tr>
        <% ownerPets.forEach(pet => { %>
            <tr>
                <td><%= pet.id %></td>
                <td><%= pet.name %></td>
                <td><%= pet.species %></td>
                <td>
                    <form action="/pets/<%= pet.id %>/delete" method="POST">
                        <button type="submit" class="btn-delete">Eliminar</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </table>
    <p>Total: <%= ownerPets.length %> mascotas</p>
<% } %>

<p><a href="/owner/<%= owner.id %>">Volver a la ficha de <%= owner.name %></a></p>

<%- include('partials/footer') %>
