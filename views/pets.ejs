<%- include('partials/header') %>

<h2>Todas las mascotas</h2>

<% if (pets.length === 0) { %>
    <p>No hay mascotas registradas.</p>
<% } else { %>
    <table>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Especie</th>
            <th>Dueño</th>
            <th>Acciones</th>
        </tr>
        <% pets.forEach(pet => { %>
            <tr>
                <td><%= pet.id %></td>
                <td><%= pet.name %></td>
                <td><%= pet.species %></td>
                <td><a href="/owner/<%= pet.ownerId %>"><%= pet.ownerName %></a></td>
                <td>
                    <form action="/pets/<%= pet.id %>/delete" method="POST">
                        <button type="submit" class="btn-delete">Eliminar</button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </table>
    <p>Total de mascotas: <%= pets.length %></p>
<% } %>

<%- include('partials/footer') %>
